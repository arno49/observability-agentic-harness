{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oah.dev/schemas/surface_map.schema.json",
  "title": "Observability Surface Map (S1 output)",
  "type": "object",
  "required": ["schema_version", "repo", "generated_by", "points"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "repo": {
      "type": "object",
      "required": ["path", "git_sha"],
      "properties": {
        "path": { "type": "string" },
        "git_sha": { "type": "string" },
        "primary_language": { "type": "string" }
      }
    },
    "generated_by": {
      "type": "object",
      "required": ["harness_version", "skill_versions"],
      "properties": {
        "harness_version": { "type": "string" },
        "skill_versions": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "file", "line", "detection", "confidence"],
        "properties": {
          "id": { "type": "string", "description": "Stable ID, e.g. sp-0042; referenced by gap model and DTOs" },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Was a closed enum of ten GenAI-pack point kinds; opened to any well-formed identifier (docs/decisions/011) so a second domain pack's own kinds validate without a schema edit. Real membership -- is this kind one THIS pack declares -- is checked against the loaded domain_pack.schema.json manifest at runtime (oah/domains/validate.py), not here."
          },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "symbol": { "type": "string", "description": "Enclosing function/class" },
          "framework": { "type": "string", "maxLength": 100, "description": "e.g. anthropic-sdk, openai-sdk, langchain, llamaindex, raw-http, celery -- a short label, never a code quote" },
          "sync_nature": { "enum": ["sync", "async", "queued", "streamed"] },
          "detection": { "enum": ["ast", "signature", "llm_disambiguation"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "notes": { "type": "string", "maxLength": 300, "description": "A short reason, never a code quote" },
          "workflow_hint": { "type": "string", "maxLength": 200, "description": "Best-effort mapping to a product workflow; confirmed in context.yaml. A short phrase, never a code quote." }
        }
      }
    },
    "coverage_stats": {
      "type": "object",
      "properties": {
        "files_scanned": { "type": "integer" },
        "points_total": { "type": "integer" },
        "points_llm_disambiguated": { "type": "integer" }
      }
    }
  }
}
