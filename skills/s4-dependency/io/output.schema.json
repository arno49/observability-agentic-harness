{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oah.dev/schemas/skills/s4-dependency/output.schema.json",
  "title": "S4 dependency lens — output",
  "description": "Like s4-slo, this is a wrapper {design_fragment, dependency_model} -- docs/decisions/011: edge criticality, the extra-nine rule, and a budget split are not expressible as design_fragment's flat signal list. Self-contained, mirroring schemas/design_fragment.schema.json and schemas/dependency_model.schema.json respectively.",
  "type": "object",
  "required": ["design_fragment", "dependency_model"],
  "additionalProperties": false,
  "properties": {
    "design_fragment": {
      "type": "object",
      "required": ["schema_version", "lens", "repo_git_sha", "signals", "failure_mode"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "lens": { "const": "dependency" },
        "repo_git_sha": { "type": "string" },
        "failure_mode": { "const": "fail_open" },
        "signals": {
          "type": "array",
          "minItems": 1,
          "description": "The event-schema-shaped half -- e.g. a pointer signal naming which dependency_model edge covers this point. The full edge structure lives in dependency_model, not here.",
          "items": {
            "type": "object",
            "required": ["name", "surface_point_ids", "maps_to", "sensitivity_tier",
                         "supports_decision", "acting_role"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "surface_point_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "maps_to": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": { "enum": ["otel_semconv", "oah_extension"] },
                  "attribute": { "type": "string" }
                }
              },
              "sensitivity_tier": { "enum": ["public", "internal", "confidential", "restricted"] },
              "pii_masked": { "type": "boolean" },
              "supports_decision": { "type": "string" },
              "acting_role": { "type": "string" },
              "latency_overhead_budget_ms": { "type": "number", "minimum": 0 }
            }
          }
        },
        "consistency_assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["description", "fields_involved"],
            "properties": {
              "description": { "type": "string" },
              "fields_involved": { "type": "array", "minItems": 2, "items": { "type": "string" } }
            }
          }
        },
        "decision_menu_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "type"],
            "properties": {
              "step": { "type": "string" },
              "type": { "enum": ["pause", "freeze", "throttle", "continue", "escalate", "rollback"] },
              "resumption_condition": { "type": "string" }
            }
          }
        }
      }
    },
    "dependency_model": {
      "type": "object",
      "description": "Same shape as schemas/dependency_model.schema.json.",
      "required": ["schema_version", "repo_git_sha", "surface_point_ids", "edges"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "repo_git_sha": { "type": "string" },
        "surface_point_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "edges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "dependency_kind", "criticality", "own_target",
                         "required_dependency_target", "budget_split", "fallback_behavior"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "dependency_kind": { "enum": ["http_client_call", "queue_producer"] },
              "criticality": { "enum": ["hard", "soft"] },
              "own_target": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "required_dependency_target": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
              "budget_split": {
                "type": "object",
                "required": ["own_failures_fraction", "dependency_failures_fraction"],
                "additionalProperties": false,
                "properties": {
                  "own_failures_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
                  "dependency_failures_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              },
              "fallback_behavior": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
