{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oah.dev/schemas/skills/s4-telemetry-cost/output.schema.json",
  "title": "S4 telemetry-cost lens — output",
  "description": "Same shape as schemas/design_fragment.schema.json, with lens fixed to telemetry-cost -- kept self-contained, matching every other lens's io/ schemas' own precedent.",
  "type": "object",
  "required": ["schema_version", "lens", "repo_git_sha", "signals", "failure_mode"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "lens": { "const": "telemetry-cost" },
    "repo_git_sha": { "type": "string" },
    "failure_mode": { "const": "fail_open" },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "surface_point_ids", "maps_to", "sensitivity_tier",
                     "supports_decision", "acting_role"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "surface_point_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "maps_to": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "const": "oah_extension" },
              "attribute": { "type": "string" }
            }
          },
          "sensitivity_tier": { "enum": ["public", "internal", "confidential", "restricted"] },
          "pii_masked": { "type": "boolean" },
          "supports_decision": { "type": "string" },
          "acting_role": { "type": "string" },
          "latency_overhead_budget_ms": { "type": "number", "minimum": 0 },
          "cardinality_guard": {
            "type": "object",
            "required": ["is_templated"],
            "additionalProperties": false,
            "description": "docs/decisions/011/026: required on the cardinality_risk signal for any route-kind point (http_server_route/declarative_route). is_templated: true when the point's own route value is guaranteed to be a low-cardinality template (S1's has_path_parameter field on the point, plus the framework's own route-registration shape, are real evidence for this -- Express/React Router both are). false when the template can't be statically recovered (e.g. a CMS resolving a URL to a content path by resource type) -- unavailable_reason is then required (oah/design/gates.py's own check_route_is_templated gate enforces this pairing).",
            "properties": {
              "is_templated": { "type": "boolean" },
              "unavailable_reason": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "consistency_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "fields_involved"],
        "properties": {
          "description": { "type": "string" },
          "fields_involved": { "type": "array", "minItems": 2, "items": { "type": "string" } }
        }
      }
    },
    "decision_menu_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "type"],
        "properties": {
          "step": { "type": "string" },
          "type": { "enum": ["pause", "freeze", "throttle", "continue", "escalate", "rollback"] },
          "resumption_condition": { "type": "string" }
        }
      }
    }
  }
}
