{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oah.dev/schemas/skills/s8-dto-generator/output.schema.json",
  "title": "S8 DTO generator — output",
  "description": "Same shape as schemas/implementation_dto.schema.json's dtos[] items (source of truth), except rollout_step is NOT produced by this skill -- SKILL.md's own hard rule: the caller assigns it deterministically from gap priority, not the model. The caller merges rollout_step in before validating the final artifact against the real implementation_dto.schema.json.",
  "type": "object",
  "required": ["schema_version", "dtos"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "dtos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "gap_id", "surface_point_ids", "change", "expected_events"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "gap_id": { "type": "string" },
          "surface_point_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "change": {
            "type": "object",
            "required": ["type", "file"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": ["wrap_call", "add_decorator", "insert_span", "propagate_context",
                         "add_collector_config", "add_compose_service", "add_feedback_endpoint",
                         "add_masking_middleware", "add_schema_file", "add_smoke_test",
                         "add_release_id_stamping", "add_degradation_event", "add_alert_route"]
              },
              "file": { "type": "string" },
              "anchor": { "type": "string" },
              "preconditions": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          },
          "expected_events": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["event_type"],
              "additionalProperties": false,
              "properties": {
                "event_type": { "enum": ["trace", "span", "generation", "retrieval_span", "tool_span",
                                          "guardrail_span", "feedback_event", "degradation_event", "escalation_event"] },
                "required_attributes": { "type": "array", "items": { "type": "string" } },
                "consistency_assertions": { "type": "array", "items": { "type": "string" } },
                "parented_under": { "type": "string" }
              }
            }
          },
          "risk": { "enum": ["low", "medium", "high"] },
          "estimated_overhead_ms": { "type": ["number", "null"] },
          "retest_triggers": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
